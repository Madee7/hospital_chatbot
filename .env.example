# Environment variables for Hospital Chatbot MVP
#
# Windows server tips:
# - Save this file as UTF-8 WITHOUT BOM (VS Code: "Save with Encoding" → UTF-8).
# - Leave Arabic clinic / CTA fields blank to use safe defaults from app/core/config.py.
# - Do not commit a real .env (secrets). Copy this file to .env on the server.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hospital_chatbot

# MVP single-clinic defaults (match seed data)
DEFAULT_TENANT_ID=1
DEFAULT_CLINIC_ID=1

# WhatsApp Cloud API
VERIFY_TOKEN=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# WhatsApp Flows doctor picker (optional — leave false to use sequential cards)
USE_DOCTOR_FLOW=false
WHATSAPP_FLOW_ID=
# Blank = Arabic default in config.py ("عرض الأطباء")
WHATSAPP_FLOW_CTA=
WHATSAPP_FLOW_DRAFT=false

# AI
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_VOICE_STRUCTURE_MODEL=gpt-4o-mini
VOICE_STT_PROMPT=false
VOICE_REQUIRE_CONFIRM=false
VOICE_SKIP_CONFIRM_THRESHOLD=0.55

# Voice router V2: LLM picks the next step; Python only validates availability.
VOICE_ROUTER_V2=true
VOICE_LANG_SESSION_MINUTES=30

# Booking policy
SLOT_HOLD_MINUTES=3
BOOKING_WINDOW_DAYS=14
MIN_LEAD_HOURS=2
CANCEL_CUTOFF_HOURS=2
RESCHEDULE_CUTOFF_HOURS=2
DUPLICATE_APPOINTMENT_DAYS=7
ALLOW_OVERBOOKING=false
REQUIRE_DOB=false
REMINDER_HOURS_BEFORE=24,2

# Clinic names — leave Arabic blank on Windows if the editor corrupts UTF-8;
# config.py defaults to دار الشفاء / Dar Al Shfaa.
CLINIC_DISPLAY_NAME=
CLINIC_LOCATION=Dar Al Shfaa
CLINIC_LOCATION_AR=
CLINIC_MAPS_URL=
RECEPTIONIST_WHATSAPP=

# Streamlit dashboard — bootstrap / seed only (sets initial password_hash).
# Runtime login uses AdminUser email + bcrypt hash in PostgreSQL.
ADMIN_DASHBOARD_PASSWORD=admin123
