# Environment variables for Hospital Chatbot MVP

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hospital_chatbot

# MVP single-clinic defaults (match seed data)
DEFAULT_TENANT_ID=1
DEFAULT_CLINIC_ID=1

# WhatsApp Cloud API
VERIFY_TOKEN=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# WhatsApp Flows doctor picker (optional — leave false to use sequential cards)
USE_DOCTOR_FLOW=false
WHATSAPP_FLOW_ID=
WHATSAPP_FLOW_CTA=عرض الأطباء
# true only while the Flow is still Draft in Meta (must use the phone number that owns the Flow)
WHATSAPP_FLOW_DRAFT=false

# AI (add when wiring conversation)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Booking policy
SLOT_HOLD_MINUTES=3
BOOKING_WINDOW_DAYS=14
MIN_LEAD_HOURS=2
CANCEL_CUTOFF_HOURS=2
RESCHEDULE_CUTOFF_HOURS=2
DUPLICATE_APPOINTMENT_DAYS=7
ALLOW_OVERBOOKING=false
REQUIRE_DOB=false
REMINDER_HOURS_BEFORE=24,2
CLINIC_DISPLAY_NAME=دار الشفاء
CLINIC_LOCATION=Dar Al Shfaa
CLINIC_LOCATION_AR=دار الشفاء
# Full Google Maps link (dashboard clinic_maps_url overrides this)
CLINIC_MAPS_URL=https://www.google.com/maps/place/30%C2%B002'49.6%22N+31%C2%B010'57.1%22E/@30.0470963,31.1847278,17z/data=!3m1!4b1!4m4!3m3!8m2!3d30.0470963!4d31.1825391?entry=ttu
RECEPTIONIST_WHATSAPP=
